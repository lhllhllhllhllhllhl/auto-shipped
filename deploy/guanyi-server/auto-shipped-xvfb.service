[Unit]
Description=Auto Shipped private Xvfb display
After=network.target

[Service]
Type=simple
User=@@RUNNER_USER@@
Group=@@RUNNER_USER@@
ExecStart=/usr/bin/Xvfb :99 -screen 0 1440x900x24 -nolisten tcp -noreset
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/auto-shipped /tmp

[Install]
WantedBy=multi-user.target
