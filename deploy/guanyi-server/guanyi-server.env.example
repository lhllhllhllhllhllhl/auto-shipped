# This file contains paths and runtime choices only. Never add credentials.
SHANGYU_SKILL_STATE_ROOT=/var/lib/auto-shipped/skill-state
GUANYI_BROWSER_BACKEND=persistent
GUANYI_CHROME_EXECUTABLE=/usr/bin/google-chrome-stable
GUANYI_RUNTIME_ROOT=/var/lib/auto-shipped/guanyi-browser
GUANYI_PROFILE_DIR=/var/lib/auto-shipped/guanyi-browser/profile
GUANYI_ARTIFACT_DIR=/var/lib/auto-shipped/guanyi-browser/artifacts
GUANYI_OPERATION_DIR=/var/lib/auto-shipped/guanyi-browser/operations
GUANYI_AUDIT_OPERATION_DIR=/var/lib/auto-shipped/guanyi-browser/audit-operations
GUANYI_LOGIN_OPERATION_DIR=/var/lib/auto-shipped/guanyi-browser/login-operations
GUANYI_REMOTE_JOB_ROOT=/var/lib/auto-shipped/inbox
GUANYI_BROWSER_SESSION_LOCK=/var/lib/auto-shipped/guanyi-browser/profile.lock
GUANYI_CREDENTIAL_HELPER=/usr/local/bin/guanyi-credential-helper
GUANYI_RESIDENT_SESSION_TTL_MS=31536000000
GUANYI_RESIDENT_SUBMISSION_INTERVAL_MS=60000
# This server has no user-facing browser takeover surface. Extra verification
# must be completed once in a trusted local browser instead.
GUANYI_HUMAN_TAKEOVER_AVAILABLE=0
GUANYI_WINDOW_WIDTH=1440
GUANYI_WINDOW_HEIGHT=900
GUANYI_WORKFLOW_RECONCILIATION_TIMEOUT_MS=45000
DISPLAY=:99
# China-hosted servers may override this with the official npm registry when reachable.
# npm ci still verifies the exact package and integrity recorded in package-lock.json.
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
