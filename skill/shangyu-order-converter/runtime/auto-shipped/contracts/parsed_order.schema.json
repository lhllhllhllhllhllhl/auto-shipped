{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangyu.local/schemas/parsed-order-v1.json",
  "title": "Shangyu Parsed Order",
  "description": "来源适配器与目标平台包之间的最小中间订单合同。只保存来源客观事实，不保存平台专属决策。",
  "type": "object",
  "x-status": "draft",
  "required": [
    "schema_version",
    "record_key",
    "source",
    "recipient",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_key": {
      "type": "string",
      "minLength": 1,
      "description": "由来源配置、文件指纹、工作表和来源行生成的稳定内部键，不是平台单号。"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "recipient": {
      "$ref": "#/$defs/recipient"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "ordered_at": {
      "type": ["string", "null"],
      "description": "来源明确提供的下单时间；没有时保持 null。"
    },
    "paid_at": {
      "type": ["string", "null"],
      "description": "来源明确提供的付款时间；没有时保持 null。"
    },
    "buyer_reference": {
      "type": ["string", "null"]
    },
    "buyer_message": {
      "type": ["string", "null"]
    },
    "source_note": {
      "type": ["string", "null"]
    },
    "amounts": {
      "$ref": "#/$defs/amounts"
    },
    "shipment_facts": {
      "$ref": "#/$defs/shipmentFacts"
    },
    "source_extensions": {
      "type": "object",
      "description": "尚未进入公共合同、但必须无损保留的来源事实。不得写入目标平台决策。",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "profile_id",
        "source_label",
        "order_type",
        "file_name",
        "sheet_name",
        "row_numbers"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "source_label": {
          "type": "string",
          "minLength": 1
        },
        "order_type": {
          "type": "string",
          "minLength": 1
        },
        "source_order_no": {
          "type": ["string", "null"]
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "file_fingerprint": {
          "type": ["string", "null"]
        },
        "sheet_name": {
          "type": "string",
          "minLength": 1
        },
        "row_numbers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "recipient": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mobile": {
          "type": ["string", "null"]
        },
        "phone": {
          "type": ["string", "null"]
        },
        "province": {
          "type": ["string", "null"]
        },
        "city": {
          "type": ["string", "null"]
        },
        "district": {
          "type": ["string", "null"]
        },
        "detail": {
          "type": ["string", "null"]
        },
        "raw_address": {
          "type": ["string", "null"],
          "description": "来源只有完整地址、尚未可靠拆分省市区时保留原文。"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "required": ["mobile"],
              "properties": {"mobile": {"type": "string", "minLength": 1}}
            },
            {
              "required": ["phone"],
              "properties": {"phone": {"type": "string", "minLength": 1}}
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": ["raw_address"],
              "properties": {"raw_address": {"type": "string", "minLength": 1}}
            },
            {
              "required": ["detail"],
              "properties": {"detail": {"type": "string", "minLength": 1}}
            }
          ]
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["quantity"],
      "properties": {
        "source_product_code": {
          "type": ["string", "null"]
        },
        "source_product_name": {
          "type": ["string", "null"]
        },
        "source_spec": {
          "type": ["string", "null"]
        },
        "source_display_spec": {
          "type": ["string", "null"],
          "description": "来源表用于人工阅读的规格文字；与商品映射使用的来源规格标识分离。"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": ["string", "null"]
        },
        "unit_price": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "source_line_no": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["source_product_code"],
          "properties": {"source_product_code": {"type": "string", "minLength": 1}}
        },
        {
          "required": ["source_product_name"],
          "properties": {"source_product_name": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "amounts": {
      "type": ["object", "null"],
      "properties": {
        "currency": {
          "type": "string",
          "default": "CNY"
        },
        "goods_amount": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "freight": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "paid_amount": {
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "shipmentFacts": {
      "type": ["object", "null"],
      "properties": {
        "carrier_name": {
          "type": ["string", "null"]
        },
        "tracking_no": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  }
}
