{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangyu.local/schemas/guanyi-order-audit-policy-v1.json",
  "title": "Guanyi Order Audit Policy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "authorization",
    "scope",
    "ui",
    "validation",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": "guanyi-order-audit-policy/1.0"},
    "policy_id": {"const": "guanyi_order_audit_v1"},
    "version": {"type": "integer", "minimum": 1},
    "authorization": {
      "type": "object",
      "required": ["mode", "supported_modes", "execute_token", "combined_mode_enabled"],
      "properties": {
        "mode": {"enum": ["separate_after_upload", "combined_import_and_audit"]},
        "supported_modes": {
          "type": "array",
          "items": {"enum": ["separate_after_upload", "combined_import_and_audit"]},
          "uniqueItems": true
        },
        "execute_token": {"const": "CONFIRM_GUANYI_ORDER_AUDIT"},
        "combined_mode_enabled": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["default", "allowed"],
      "properties": {
        "default": {"enum": ["all_pending", "current_batch"]},
        "allowed": {
          "type": "array",
          "items": {"enum": ["all_pending", "current_batch"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "required": [
        "audit_column_title",
        "platform_order_column_title",
        "audit_button_text",
        "query_button_text",
        "pending_status_candidates",
        "confirmed_pending_status",
        "successful_statuses"
      ],
      "properties": {
        "audit_column_title": {"type": "string", "minLength": 1},
        "platform_order_column_title": {"type": "string", "minLength": 1},
        "audit_button_text": {"type": "string", "minLength": 1},
        "query_button_text": {"type": "string", "minLength": 1},
        "pending_status_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "confirmed_pending_status": {"type": ["string", "null"]},
        "successful_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["status", "required_environments", "validated_environments"],
      "properties": {
        "status": {"enum": ["pending_read_only_probes", "ready"]},
        "required_environments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"enum": ["local", "doubao"]},
          "uniqueItems": true
        },
        "validated_environments": {
          "type": "array",
          "maxItems": 2,
          "items": {"enum": ["local", "doubao"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": [
        "requires_verified_import",
        "requires_separate_user_authorization",
        "re_audit_successful_orders_is_idempotent",
        "shipping_allowed",
        "void_allowed",
        "delete_allowed"
      ],
      "properties": {
        "requires_verified_import": {"const": true},
        "requires_separate_user_authorization": {"type": "boolean"},
        "re_audit_successful_orders_is_idempotent": {"const": true},
        "shipping_allowed": {"const": false},
        "void_allowed": {"const": false},
        "delete_allowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
