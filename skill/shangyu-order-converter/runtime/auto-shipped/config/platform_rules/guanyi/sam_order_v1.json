{
  "schema_version": "1.0",
  "profile_id": "guanyi_sam_order_v1",
  "source_profile_id": "sam_order_v1",
  "target_profile_id": "guanyi_order_import_v1",
  "version": 10,
  "policy_module_refs": {
    "store_assignment_policy": {"registry_id": "guanyi_policy_modules_v1", "module_id": "store.sam_fixed.v1"},
    "defaults": {"registry_id": "guanyi_policy_modules_v1", "module_id": "defaults.standard_sales.v1"},
    "logistics_policy": {"registry_id": "guanyi_policy_modules_v1", "module_id": "logistics.source_override_then_corn_packaging.v1"},
    "note_routing_policy": {"registry_id": "guanyi_policy_modules_v1", "module_id": "note.courier_instruction_to_address.v1"},
    "seller_remark_policy": {"registry_id": "guanyi_policy_modules_v1", "module_id": "remark.source_then_system.v1"}
  },
  "policy_module_overrides": {
    "defaults": {
      "freight": {"value": "", "confirmed": true, "source": "已确认人工成品运费留空"}
    }
  },
  "platform_order_number": {
    "strategy": "source_order_no",
    "confirmed": true,
    "source": "发货SOP第8页；真实SAM样本已定位来源单号列：2026-10-01"
  },
  "field_output_policy": {
    "product_name": {
      "strategy": "source_name_with_display_spec_for_standard_items",
      "confirmed": true,
      "source": "用户确认SAM商品名称应贴近人工习惯；普通商品使用来源品名与来源规格拼接，组合展开商品仍使用各目标商品的管易名称；2026-10-04"
    },
    "spec_name": {
      "strategy": "catalog_spec_name",
      "confirmed": true,
      "source": "统一商品映射规则"
    },
    "order_created_at": {
      "strategy": "blank",
      "confirmed": true,
      "source": "当前SAM真实样本没有下单时间字段；管易自定义导入允许省略该非必填列"
    },
    "contact_columns": {
      "strategy": "mobile_to_both_phone_preserved",
      "confirmed": true,
      "source": "用户确认：只有手机号码时联系电话和联系手机均填写该号码"
    },
    "recipient_region": {
      "strategy": "source_components",
      "confirmed": true,
      "source": "真实SAM样本提供省、市、区独立字段"
    }
  },
  "buyer_member_policy": {
    "strategy": "sam_product_type_date_group",
    "platform_prefix": "sam",
    "group_number_field": "sam_group_number",
    "group_separator": "_",
    "date_format": "%y%m%d",
    "timezone": "Asia/Shanghai",
    "on_missing_group_number": "ask_user",
    "on_unknown_product_type": "ask_user",
    "on_multiple_product_types": "ask_user",
    "product_type_rules": [
      {
        "rule_id": "sam_product_type_corn",
        "type_code": "YM",
        "match": {
          "product_name_contains_all": ["玉米"]
        },
        "confirmed": true,
        "source": "用户确认：YM为玉米缩写；2026-10-02"
      },
      {
        "rule_id": "sam_product_type_shanghe_gloves",
        "type_code": "SH",
        "match": {
          "product_name_contains_all": ["手套"],
          "any_text_contains": ["尚和", "尚合"]
        },
        "confirmed": true,
        "source": "用户确认：尚和手套使用SH；兼容历史资料中的尚合写法；2026-10-02"
      },
      {
        "rule_id": "sam_product_type_showa_swsh8072",
        "type_code": "SH",
        "match": {
          "product_codes": ["SWSH8072"],
          "spec_codes": ["4901792038072"]
        },
        "confirmed": true,
        "source": "SAM原始订单与人工成品按同一平台单号核对，人工买家会员为samSH260930_1977；用户确认按当前普通商品规则处理；2026-10-02"
      }
    ],
    "confirmed": true,
    "source": "尚舆发货流程PDF规则经用户纠错确认：sam+商品类型缩写+当日YYMMDD+_+跟团号；2026-10-02"
  },
  "item_expansion_policy": {
    "strategy": "confirmed_source_item_expansions",
    "on_unmatched": "standard_product_mapping",
    "confirmed": true,
    "rules": [
      {
        "rule_id": "sam_corn_white_8_plus_1",
        "match": {
          "source_product_code": "276388650",
          "source_spec": "光9-JTBN1T1-EH"
        },
        "components": [
          {
            "product_code": "JTBN1E1-EH",
            "spec_code": "6974768564842",
            "quantity_multiplier": 1
          },
          {
            "product_code": "GMBN1",
            "spec_code": "6974768564804",
            "quantity_multiplier": 1
          }
        ],
        "confirmed": true,
        "source": "SAM原始样本与人工成品逐行对照；用户确认云仓无8+1/9根组合，需要拆为8根装和单根装；2026-10-02"
      }
    ]
  },
