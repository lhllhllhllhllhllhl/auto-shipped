{
  "schema_version": "1.0",
  "profile_id": "guanyi_sam_order_v1",
  "source_profile_id": "sam_order_v1",
  "target_profile_id": "guanyi_order_import_v1",
  "version": 16,
  "policy_module_refs": {
    "store_assignment_policy": {"registry_id": "guanyi_policy_modules_v1", "module_id": "store.sam_fixed.v1"},
    "defaults": {"registry_id": "guanyi_policy_modules_v1", "module_id": "defaults.standard_sales.v1"},
    "logistics_policy": {"registry_id": "guanyi_policy_modules_v1", "module_id": "logistics.source_override_then_corn_packaging.v1"},
    "note_routing_policy": {"registry_id": "guanyi_policy_modules_v1", "module_id": "note.courier_instruction_to_address.v1"},
    "seller_remark_policy": {"registry_id": "guanyi_policy_modules_v1", "module_id": "remark.source_then_system.v1"}
  },
  "policy_module_overrides": {
    "defaults": {
      "freight": {"value": "", "confirmed": true, "source": "已确认人工成品运费留空"}
    }
  },
  "platform_order_number": {
    "strategy": "preferred_order_identity",
    "confirmed": true,
    "source": "发货SOP第8页；真实SAM样本已定位来源单号列：2026-10-01"
  },
  "field_output_policy": {
    "product_name": {
      "strategy": "catalog_product_name",
      "confirmed": true,
      "source": "用户确认：商品代码和规格代码确定后，普通商品与组合展开商品均从有效商品目录回填标准商品名称；2026-10-16"
    },
    "spec_name": {
      "strategy": "catalog_spec_name",
      "confirmed": true,
      "source": "统一商品映射规则"
    },
    "order_created_at": {
      "strategy": "blank",
      "confirmed": true,
      "source": "当前SAM真实样本没有下单时间字段；管易自定义导入允许省略该非必填列"
    },
    "contact_columns": {
      "strategy": "mobile_to_both_phone_preserved",
      "confirmed": true,
      "source": "用户确认：只有手机号码时联系电话和联系手机均填写该号码"
    },
    "recipient_region": {
      "strategy": "source_components",
      "confirmed": true,
      "source": "真实SAM样本提供省、市、区独立字段"
    }
  },
  "buyer_member_policy": {
    "strategy": "sam_product_type_date_group",
    "platform_prefix_source": "company_abbreviation_lower",
    "group_number_field": "sam_group_number",
    "group_separator": "_",
    "date_format": "%y%m%d",
    "timezone": "Asia/Shanghai",
    "on_missing_group_number": "generate_daily_sequence",
    "fallback_stamp_format": "%y%m%d",
    "fallback_sequence_separator": "_",
    "fallback_sequence_start": 1,
    "fallback_sequence_width": 3,
    "on_unknown_product_type": "ask_user",
    "on_multiple_product_types": "ask_user",
    "product_type_rules": [
      {
        "rule_id": "sam_product_type_corn",
        "type_code": "YM",
        "match": {
          "product_name_contains_all": ["玉米"]
        },
        "confirmed": true,
        "source": "用户确认：YM为玉米缩写；2026-10-02"
      },
      {
        "rule_id": "sam_product_type_showa_gloves_by_source_semantics",
        "type_code": "SH",
        "match": {
          "source_text_contains_all": ["手套"],
          "source_text_contains_any": ["SHOWA", "尚和", "尚合"]
        },
        "confirmed": true,
        "source": "用户确认：SAM的SHOWA/尚和/尚合手套统一使用既有SH类型；来源语义完整时自动归类；2026-10-02、2026-10-20"
      },
      {
        "rule_id": "sam_product_type_showa_confirmed_sku_fallback",
        "type_code": "SH",
        "match": {
          "product_spec_pairs": [
            ["SWSH8072", "4901792038072"],
            ["SWHL3610", "4901792023610"],
            ["SWJC8133", "4901792038133"],
            ["SWJC8140", "4901792038140"],
            ["SWSH8096", "4901792038096"],
            ["SWJH7693", "4901792037693"]
          ]
        },
        "confirmed": true,
        "source": "已确认的SAM SHOWA手套目标SKU均归入既有SH类型；包含2026-10-20正式映射SWJH7693/4901792037693；用于代码型来源或来源名称不完整时兜底"
      }
    ],
    "confirmed": true,
    "source": "有跟团号时沿用sam+商品类型缩写+当日YYMMDD+_+跟团号；无跟团号时使用sam+商品类型缩写+YYMMDD+_+最少三位飞书中央日序号；用户确认：2026-10-12、2026-10-17"
  },
  "item_expansion_policy": {
    "strategy": "confirmed_source_item_expansions",
    "on_unmatched": "standard_product_mapping",
    "registry_source": "feishu_official_item_expansions",
    "confirmed": true,
    "rules": []
  },
  "business_rule_coverage": {
    "catalog_id": "shangyu_shipping_sop_v1",
    "scope_id": "sam_to_guanyi_v1",
    "rules": {
      "GY-STORE-ASSIGNMENT": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.store_assignment.fixed",
        "evidence": "SAM规则包引用统一店铺策略模块中的固定sam店铺。"
      },
      "GY-PLATFORM-ORDER-NUMBER": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.platform_order.preferred_order_identity",
        "evidence": "公共规则优先订单编号，缺失时回退来源单号；SAM现有复合列作为可用回退身份。"
      },
      "GY-BUYER-MEMBER": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.buyer_member.sam_pattern",
        "evidence": "有跟团号时按sam+商品类型缩写+当日日期+_+跟团号生成；无跟团号时按商品类型前缀使用飞书中央日序号；YM为玉米，SH为SHOWA/尚和/尚合手套。"
      },
      "GY-PAYMENT-VALUES": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.defaults.zero_amounts",
        "evidence": "用户确认SAM价格与支付金额填0；运费跟随人工成品留空。"
      },
      "GY-WAREHOUSE-ASSIGNMENT": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.defaults.warehouse_name",
        "evidence": "SOP统一使用上海尚舆商贸有限公司仓库。"
      },
      "GY-PAYMENT-METHOD": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.defaults.payment_method",
        "evidence": "用户确认该字段可空或显式填写；系统选择显式填写网银在线，避免依赖管易默认值。"
      },
      "GY-ORDER-TYPE": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.defaults.order_type",
        "evidence": "用户确认该字段可空或显式填写；系统选择显式填写销售订单，避免依赖管易默认值。"
      },
      "GY-ORDER-FLAGS": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.defaults.order_flags",
        "evidence": "管易导入说明中的三个标记均为0。"
      },
      "GY-PRODUCT-MAPPING": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.product_catalog.confirmed_exact",
        "evidence": "共享映射模块已实现；样本中的实际SKU仍必须单独确认。"
      },
      "GY-ITEM-EXPANSION": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.item_expansion.confirmed_source_components",
        "evidence": "组合展开执行器读取飞书正式库的组合商品规则；SAM白糯、花糯和黄糯三种8+1已迁入中央规则表，普通规则包不再复制组成明细。"
      },
      "GY-RECIPIENT-COMPLETENESS": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "source.recipient.required_fields",
        "evidence": "SAM来源解析器阻断缺失收件人、联系方式和完整地址；2026-10-05起非法联系方式也阻断。"
      },
      "GY-LOGISTICS-SELECTION": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.logistics.corn_packaging_policy",
        "evidence": "使用已确认的玉米包装数量规则；来源指定物流优先但必须先命中已登记管易标准名称。"
      },
      "GY-SELLER-REMARK-POLICY": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.seller_remark.rule_composition",
        "evidence": "备注分流后的非快递员备注写入卖家备注；买家备注保留为买家留言。"
      },
      "GY-DAILY-GOODS-WHITE-LABEL": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.seller_remark.white_label_sku_library",
        "evidence": "商品精确映射后读取独立白标SKU库；任一商品命中则整单卖家备注追加白标商品。"
      },
      "GY-DELIVERY-INSTRUCTION-ADDRESS": {
        "status": "implemented",
        "confirmed": true,
        "implementation_ref": "guanyi.note_routing.courier_instruction_to_address",
        "evidence": "共享备注分流模块把快递员指令追加到收货地址末尾。"
      }
    }
  }
}
