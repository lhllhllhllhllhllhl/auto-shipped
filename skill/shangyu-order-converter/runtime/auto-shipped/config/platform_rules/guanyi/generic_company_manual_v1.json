  "platform_order_number": {
    "strategy": "preferred_order_identity",
    "on_missing": "generate_daily_sequence",
    "prefix_source": "company_abbreviation",
    "date_format": "%Y%m%d",
    "sequence_width": 3,
    "sequence_start": 1,
    "sequence_separator": "",
    "timezone": "Asia/Shanghai",
    "confirmed": true,
    "source": "优先使用订单编号、缺失时使用来源单号；两者均无时由共享转换入口按公司简称+YYYYMMDD+飞书中央日序号生成；不追加A。"
  },
  "field_output_policy": {
    "product_name": {"strategy": "catalog_product_name", "confirmed": true, "source": "使用有效商品目录名称"},
    "spec_name": {"strategy": "catalog_spec_name", "confirmed": true, "source": "使用有效商品目录规格"},
    "order_created_at": {"strategy": "blank", "confirmed": true, "source": "未提供真实下单时间时留空"},
    "contact_columns": {"strategy": "mobile_to_both_phone_preserved", "confirmed": true, "source": "号码及隐私号尾缀整体保留"},
    "recipient_region": {"strategy": "source_components", "confirmed": true, "source": "只提取明确省市区；不确定时追问"}
  },
  "business_rule_coverage": {
    "catalog_id": "shangyu_shipping_sop_v1",
    "scope_id": "generic_company_manual_to_guanyi_v1",
    "rules": {
      "GY-STORE-ASSIGNMENT": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.store_assignment.by_manual_route_then_product", "evidence": "先查已确认SKU—店铺关联；未命中时玉米兜底到光明满元气、非玉米兜底到淘橘子并在结果小节告知；混合店铺追问。"},
      "GY-PLATFORM-ORDER-NUMBER": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.platform_order.prefix_daily_sequence", "evidence": "缺少订单编号和来源单号时按公司简称、业务日期和飞书中央日序号生成。"},
      "GY-BUYER-MEMBER": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.buyer_member.policy", "evidence": "普通来源固定张。"},
      "GY-PAYMENT-VALUES": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.defaults.zero_amounts", "evidence": "普通手工订单金额规则。"},
      "GY-WAREHOUSE-ASSIGNMENT": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.defaults.warehouse_name", "evidence": "SOP统一仓库。"},
      "GY-PAYMENT-METHOD": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.defaults.payment_method", "evidence": "显式填写网银在线。"},
      "GY-ORDER-TYPE": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.defaults.order_type", "evidence": "显式填写销售订单。"},
      "GY-ORDER-FLAGS": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.defaults.order_flags", "evidence": "导入标记为0。"},
      "GY-PRODUCT-MAPPING": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.product_catalog.confirmed_exact", "evidence": "编码、条码与正式映射优先；名称只在唯一可信时形成预览，无法唯一判断时集中追问。"},
      "GY-RECIPIENT-COMPLETENESS": {"status": "implemented", "confirmed": true, "implementation_ref": "source.recipient.required_fields", "evidence": "文字草稿或自适应Excel门禁校验收件信息。"},
      "GY-LOGISTICS-SELECTION": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.logistics.corn_packaging_policy", "evidence": "来源指定优先；未指定时使用共享玉米包装物流规则。"},
      "GY-SELLER-REMARK-POLICY": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.seller_remark.rule_composition", "evidence": "备注统一分流。"},
      "GY-DAILY-GOODS-WHITE-LABEL": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.seller_remark.white_label_sku_library", "evidence": "命中独立白标SKU库时追加备注。"},
      "GY-DELIVERY-INSTRUCTION-ADDRESS": {"status": "implemented", "confirmed": true, "implementation_ref": "guanyi.note_routing.courier_instruction_to_address", "evidence": "快递员指令追加到地址末尾。"}
    }
  }
}
