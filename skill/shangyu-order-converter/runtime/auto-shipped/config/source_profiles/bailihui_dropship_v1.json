    "source_spec": "69码",
    "quantity": "数量",
    "carrier": "物流公司",
    "tracking_no": "物流单号",
    "source_note": "备注",
    "ordered_at": "下单日期"
  },
  "consistency_fields": [
    "recipient_name",
    "contact",
    "address",
    "source_note",
    "ordered_at",
    "carrier",
    "tracking_no"
  ],
  "grouping": {
    "order_key": "采购单号",
    "one_row_per": "source_order_item"
  },
  "order_row_policy": {
    "purchase_type_field": "采购类型",
