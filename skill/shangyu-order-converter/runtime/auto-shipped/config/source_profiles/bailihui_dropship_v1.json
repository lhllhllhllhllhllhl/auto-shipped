  "source_note_cleanup": {
    "strategy": "remove_exact_phrases_preserve_remainder",
    "remove_exact_phrases": [
      "【请在24小时内使用快递发货，发货时请保证货品清洁，邮寄时请用邮购箱发货。】"
    ],
    "confirmed": true,
    "source": "用户于2026-10-30确认该句为百礼汇每单固定模板提示；删除固定句，保留同一备注单元格中的其他内容。"
  }
