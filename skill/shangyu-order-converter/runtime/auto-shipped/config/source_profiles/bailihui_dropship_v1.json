      "收货电话",
      "收货地址",
      "下单日期"
    ],
    "known_headers": [
      "采购单号",
      "采购类型",
      "采购状态",
      "产品名称",
      "SKU码",
      "SKU",
      "69码",
      "数量",
      "单价",
      "商品金额",
      "标准运费",
      "收货人",
      "收货电话",
      "收货地址",
      "下单日期",
      "备注",
