  },
  "fields": {
    "source_order_no": "订单编号",
    "recipient_name": "收件人姓名",
    "contact": "收件人手机",
    "address": "完整地址",
    "product_name": "礼品名称",
    "source_display_spec": "礼品规格",
    "quantity": "数量",
    "carrier": "快递公司",
    "tracking_no": "快递单号",
    "source_note": "送货时间",
    "ordered_at": "订单生成时间"
  },
  "consistency_fields": [
    "recipient_name",
    "contact",
    "address",
    "source_note",
    "ordered_at",
    "carrier",
    "tracking_no"
  ],
  "grouping": {
    "order_key": "订单编号",
    "one_row_per": "source_order"
  },
  "order_row_policy": {
    "allowed_product_names": ["光明 福利套餐四"],
    "status_field": "订单状态",
    "allowed_statuses": ["待发货"],
    "delivery_field": "配送方式",
    "allowed_delivery": ["邮寄"]
  },
  "bundle_identity_guard": {
    "bundle_title": "光明满元气鲜食玉米2袋组合",
    "components": [
      {
        "source_component_name": "黄糯玉米8根装",
