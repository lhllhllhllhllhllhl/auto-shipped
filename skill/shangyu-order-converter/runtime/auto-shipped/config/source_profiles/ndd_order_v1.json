      },
      {
        "source_component_name": "白糯玉米8根装",
        "quantity_per_bundle": 1
      }
    ],
    "on_change": "ask_user",
    "evidence": "NDD原始样本套餐说明和人工管易成品逐单对照：2026-10-05"
  }
