      "礼品名称",
      "数量",
      "订单状态",
      "配送方式",
      "收件人姓名",
      "收件人手机",
      "完整地址",
      "订单生成时间",
      "套餐配套商品信息",
      "送货时间"
    ],
    "known_headers": [
      "商品小计",
      "订单编号",
      "礼品名称",
      "礼品描述",
      "礼品价格",
      "数量",
      "订单状态",
      "配送方式",
      "收件人姓名",
      "收件人手机",
      "完整地址",
      "快递公司",
      "快递单号",
      "兑换码",
      "订单生成时间",
      "自提点名称",
      "自提点地址",
      "提货人姓名",
      "提货人手机",
      "礼品规格",
      "套餐配套商品信息",
      "送货时间"
    ],
    "unknown_header_policy": "warn",
    "company_identity": {
      "required": true,
      "on_missing": "ask_user",
