      "source_refs": ["管易自定义订单导入说明"],
      "allowed_implementation_refs": ["guanyi.defaults.order_flags"]
    },
    "GY-PRODUCT-MAPPING": {
      "title": "将来源商品映射为管易商品和规格编码",
      "module": "guanyi.product_mapping",
      "phase": "conversion",
      "source_refs": ["尚舆发货流程.pdf p.4", "p.8", "p.10", "p.12"],
      "allowed_implementation_refs": ["guanyi.product_catalog.confirmed_exact"],
      "reason": "名称相似只能形成候选；商品或规格映射未确认时必须阻断。"
    },
    "GY-ITEM-EXPANSION": {
      "title": "将来源组合商品展开为多个管易商品行",
      "module": "guanyi.item_expansion",
      "phase": "conversion",
      "source_refs": ["SAM原始订单与人工管易成品对照", "用户确认：2026-10-02"],
      "allowed_implementation_refs": [
        "guanyi.item_expansion.confirmed_source_components"
      ],
      "reason": "组合商品不得伪装成同一来源编码的多条普通映射；必须按已确认组成和数量倍数展开。"
    },
    "GY-RECIPIENT-COMPLETENESS": {
      "title": "校验收件人、联系方式和完整地址",
      "module": "guanyi.recipient_validation",
      "phase": "conversion",
      "source_refs": ["尚舆发货流程.pdf p.5", "p.8", "p.10"],
      "allowed_implementation_refs": ["source.recipient.required_fields"]
    },
    "GY-JD-ZTO-CONTACT-SUFFIX": {
      "title": "自营京东中通订单把姓名后的四位码追加到联系方式",
      "module": "guanyi.contact_suffix_policy",
      "phase": "conversion",
      "source_refs": ["SRC-SAMPLE-TEXT-ORDER-001", "DEC-USER-JD-ZTO-CONTACT-SUFFIX-001"],
      "allowed_implementation_refs": [
        "guanyi.contact_suffix.jd_zhongtong_recipient_marker"
      ],
      "reason": "京东中通订单需要以号码-四位码形式传递平台隐私号后缀；四位码缺失或姓名、地址、已有号码尾码冲突时必须阻断并追问。"
    },
    "GY-LOGISTICS-SELECTION": {
      "title": "按商品与数量选择韵达或中通重货",
      "module": "guanyi.logistics_policy",
      "phase": "conversion",
      "source_refs": ["尚舆发货流程.pdf p.3", "p.10"],
      "allowed_implementation_refs": [
        "guanyi.logistics.source_passthrough",
        "guanyi.logistics.corn_packaging_policy",
        "guanyi.logistics.default_yunda",
        "guanyi.logistics.weight_threshold"
      ],
      "question": "如果以后用重量公式替换当前包装规则，请提供重量阈值和适用商品重量。",
      "reason": "当前版本已确认按包装数量执行；未来重量公式作为可替换策略实现。",
      "answer_type": "single_choice",
      "choices": [
        "按8根装数量≥2或10根礼盒装走中通，其余韵达",
        "按整单重量判断，我将提供重量阈值",
        "来源文件必须提供物流公司，系统不自动判断"
      ]
    },
    "GY-SELLER-REMARK-POLICY": {
      "title": "生成管易卖家备注",
      "module": "guanyi.seller_remark_policy",
      "phase": "conversion",
      "source_refs": ["尚舆发货流程.pdf p.3"],
      "allowed_implementation_refs": [
        "guanyi.seller_remark.source_note_passthrough",
        "guanyi.seller_remark.rule_composition"
      ],
      "question": "后续新增系统提示时，按已确认的卖家备注组合策略接入。",
      "reason": "客户备注写入卖家备注已经确认；系统提示按固定顺序追加并精确去重。"
    },
    "GY-DELIVERY-INSTRUCTION-ADDRESS": {
      "title": "把快递员配送指令追加到收货地址末尾",
      "module": "guanyi.note_routing_policy",
      "phase": "conversion",
      "source_refs": ["用户确认：2026-10-09", "codex-clipboard-0e8d0696-b4b1-41fd-868a-56d28e506fe3.jpg"],
      "allowed_implementation_refs": [
        "guanyi.note_routing.courier_instruction_to_address"
      ],
      "reason": "送货上门、不准放门口等给快递员的指令必须随收货地址传递；非快递员备注继续进入卖家备注。"
    },
    "GY-DAILY-GOODS-WHITE-LABEL": {
      "title": "精确白标SKU命中后整单添加白标商品备注",
      "module": "guanyi.seller_remark_policy",
      "phase": "conversion",
      "source_refs": [
        "DEC-USER-WHITELABEL-LIB-001",
        "config/catalog/white_label_skus_v1.json"
      ],
      "allowed_implementation_refs": ["guanyi.seller_remark.white_label_sku_library"],
      "reason": "商品完成管易代码和规格代码映射后精确匹配版本化白标库；任一商品命中则整单卖家备注追加白标商品。"
    },
    "GY-IMPORT-STATUS-PENDING-REVIEW": {
      "title": "导入订单状态选择待审核",
      "module": "guanyi.browser.import_form",
      "phase": "upload",
      "source_refs": ["尚舆发货流程.pdf p.9"],
      "allowed_implementation_refs": ["browser.guanyi.prepare_import_form.pending_review"]
    },
    "GY-IMPORT-OPTIONS": {
      "title": "确认自定义导入页面的附加勾选项",
      "module": "guanyi.browser.import_form",
      "phase": "upload",
      "source_refs": ["尚舆发货流程.pdf p.9"],
      "allowed_implementation_refs": ["browser.guanyi.import_options.verified_current_ui"],
      "question": "业务已确认自定义导入页面下面两项都要勾选；上传模块需完成精确定位、勾选和回读验收。",
      "reason": "业务规则已确认，当前缺少浏览器执行器实现和真实页面验收。"
    },
    "GY-UPLOAD-SUBMISSION": {
      "title": "点击确定并提交自定义订单导入",
