{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangyu.local/schemas/batch-conversion-result-v1.json",
  "title": "Shangyu Batch Conversion Result",
  "type": "object",
  "required": [
    "status",
    "source_count",
    "order_count",
    "item_row_count",
    "sources",
    "outputs",
    "upload_manifest",
    "clarifications",
    "decision_bundle",
    "mapping_reuse_bundle",
    "mapping_evidence",
    "store_assignment_notices",
    "errors"
  ],
  "properties": {
    "status": { "enum": ["ready", "preview_ready", "needs_input", "blocked"] },
    "source_count": { "type": "integer", "minimum": 0 },
    "order_count": { "type": "integer", "minimum": 0 },
    "item_row_count": { "type": "integer", "minimum": 0 },
    "target_platform": { "type": ["string", "null"] },
    "target_profile_id": { "type": ["string", "null"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_file",
          "source_sha256",
          "status",
          "parsed_order_count",
          "output_row_count",
          "schema_warnings",
          "clarifications",
          "decisions",
          "store_assignment_notices",
          "errors"
        ],
        "properties": {
          "source_file": { "type": "string", "minLength": 1 },
          "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "status": { "type": "string", "minLength": 1 },
          "source_profile_id": { "type": ["string", "null"] },
          "company_id": { "type": ["string", "null"] },
          "route_id": { "type": ["string", "null"] },
          "target_platform": { "type": ["string", "null"] },
          "target_profile_id": { "type": ["string", "null"] },
          "parsed_order_count": { "type": "integer", "minimum": 0 },
          "output_row_count": { "type": "integer", "minimum": 0 },
          "schema_warnings": { "type": "array", "items": { "type": "object" } },
          "clarifications": { "type": "array", "items": { "type": "object" } },
          "decisions": { "type": "array", "items": { "type": "object" } },
          "store_assignment_notices": {
            "type": "array",
            "description": "非阻断店铺兜底说明；不含收件信息。",
            "items": {"$ref": "#/$defs/storeAssignmentNotice"}
          },
          "errors": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "upload_manifest": { "type": ["string", "null"] },
    "clarifications": { "type": "array", "items": { "type": "object" } },
    "decision_bundle": {"$ref": "decision_bundle.schema.json"},
    "mapping_reuse_bundle": {"$ref": "mapping_reuse_bundle.schema.json"},
    "mapping_evidence": {
      "type": "array",
      "description": "本批商品匹配证据；不含收件人、电话或地址。",
      "items": {"type": "object"}
    },
    "store_assignment_notices": {
      "type": "array",
      "description": "本批已执行的非阻断店铺兜底说明；只用于结果告知，不要求再次确认。",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/storeAssignmentNotice"},
          {
            "type": "object",
            "properties": {"source_file": {"type": "string", "minLength": 1}},
            "required": ["source_file"]
          }
        ]
      }
    },
    "errors": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "storeAssignmentNotice": {
      "type": "object",
      "required": [
        "code",
        "scope",
        "source_ref",
        "store",
        "rule_id",
        "message",
        "product",
        "blocking"
      ],
      "properties": {
        "code": {"const": "NON_CORN_TO_TAOJUZI_FALLBACK"},
        "scope": {"const": "order"},
        "source_ref": {"type": "string", "minLength": 1},
        "store": {"const": "淘橘子"},
        "rule_id": {"const": "confirmed_non_corn_to_taojuzi"},
        "message": {"type": "string", "minLength": 1},
        "product": {
          "type": "object",
          "required": ["product_code", "spec_code"],
          "properties": {
            "product_code": {"type": "string", "minLength": 1},
            "spec_code": {"type": "string"}
          },
          "additionalProperties": false
        },
        "blocking": {"const": false},
        "source_file": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
