{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangyu.local/schemas/adaptive-source-plan-v1.json",
  "title": "Shangyu Adaptive Excel Source Plan",
  "description": "未知Excel模板在用户确认公司后使用的一次性字段映射计划。计划不得保存订单数据值或收件信息。",
  "type": "object",
  "required": [
    "schema_version",
    "plan_type",
    "plan_id",
    "source_sha256",
    "company_id",
    "rule_source_profile_id",
    "sheet_name",
    "header_row",
    "structure_signature",
    "field_mapping",
    "batch_defaults",
    "order_number"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_type": {"const": "adaptive_excel_source"},
    "plan_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "confirmed"]},
    "source_file": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "order_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "可选的稳定订单事实指纹；文字来源重生成同内容XLSX时保持不变，缺省回退source_sha256。"
    },
    "company_id": {"type": "string", "minLength": 1},
    "rule_source_profile_id": {"type": "string", "minLength": 1},
    "sheet_name": {"type": "string", "minLength": 1},
    "header_row": {"type": "integer", "minimum": 1},
    "structure_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "field_mapping": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/fieldMapping"}
    },
    "layout_mode": {
      "enum": ["row_orders", "single_order_labeled_item_table"],
      "description": "缺省为逐行订单；标签式商品表把多行商品与页尾统一收件信息组成一张订单。"
    },
    "batch_field_mapping": {
      "type": "object",
      "description": "只保存页尾标签对应的单元格位置，不保存姓名、电话或地址值。",
      "propertyNames": {
        "enum": ["recipient_name", "contact", "address", "combined_recipient_contact"]
      },
      "additionalProperties": {"$ref": "#/$defs/cellMapping"}
    },
    "extension_mapping": {
      "type": "object",
      "description": "需要保留给公司规则使用、但不属于统一订单核心字段的来源扩展字段。",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/fieldMapping"}
    },
    "batch_defaults": {
      "type": "object",
      "properties": {
        "product_code": {"type": ["string", "null"]},
        "product_name": {"type": ["string", "null"]},
        "source_spec": {"type": ["string", "null"]},
        "quantity": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "province": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "district": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "order_number": {
      "oneOf": [
        {
          "type": "object",
          "properties": {"strategy": {"const": "source_column"}},
          "required": ["strategy"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "strategy": {"const": "central_daily_sequence"}
          },
          "required": ["strategy"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "strategy": {"const": "date_sequence"},
            "business_date": {"type": "string", "format": "date"},
            "prefix": {"type": "string", "pattern": "^[0-9A-Za-z_-]{0,16}$"},
            "sequence_start": {"type": "integer", "minimum": 0},
            "sequence_width": {"type": "integer", "minimum": 1, "maximum": 8}
          },
          "required": ["strategy", "business_date"],
          "additionalProperties": false
        }
      ]
    },
    "assumption_confirmation_token": {
      "type": "string",
      "description": "只有用户明确确认原表缺失的批次默认值和单号规则后才允许填写。"
    },
    "unresolved_fields": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "source_confirmation": {
      "type": "object",
      "description": "文字或截图来源的最终核对状态；pending只允许生成不可上传的预览。",
      "required": ["status", "draft_id", "source_sha256", "order_count"],
      "properties": {
        "status": {"enum": ["pending", "confirmed"]},
        "draft_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "order_count": {"type": "integer", "minimum": 1},
        "masked_order_preview": {
          "type": "array",
          "description": "只供预览Excel交付后的批次级核对使用，不含完整收件信息。",
          "items": {
            "type": "object",
            "required": [
              "order_ref", "source_channel", "order_no", "source_order_no",
              "order_number_plan", "recipient", "items", "source_carrier"
            ],
            "properties": {
              "order_ref": {"type": "string", "minLength": 1},
              "source_channel": {"type": "string"},
              "order_no": {"enum": ["present", "missing"]},
              "source_order_no": {"enum": ["present", "missing"]},
              "order_number_plan": {
                "type": "object",
                "required": ["identity_priority", "selected_source", "message"],
                "properties": {
                  "identity_priority": {"type": "string", "minLength": 1},
                  "selected_source": {
                    "enum": [
                      "order_no", "source_order_no",
                      "registered_generation_rule", "missing"
                    ]
                  },
                  "message": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              },
              "recipient": {
                "type": "object",
                "required": ["name", "contact", "address"],
                "properties": {
                  "name": {"type": "string"},
                  "contact": {"type": "string"},
                  "address": {"type": "string"}
                },
                "additionalProperties": false
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["product", "spec", "quantity", "unit"],
                  "properties": {
                    "product": {"type": "string"},
                    "spec": {"type": "string"},
                    "quantity": {"type": "number", "exclusiveMinimum": 0},
                    "unit": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              },
              "source_carrier": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fieldMapping": {
      "type": "object",
      "required": ["columns", "expected_headers", "separator"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z]{1,3}$"}
        },
        "expected_headers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "separator": {"type": "string"}
      },
      "additionalProperties": false
    },
    "cellMapping": {
      "type": "object",
      "required": ["cell"],
      "properties": {
        "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"}
      },
      "additionalProperties": false
    }
  }
}
