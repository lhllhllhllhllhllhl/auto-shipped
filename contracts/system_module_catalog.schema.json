{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangyu.local/schemas/system-module-catalog-v1.json",
  "title": "Shangyu System Module Catalog",
  "type": "object",
  "required": ["schema_version", "catalog_id", "modules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "catalog_id": {"type": "string", "minLength": 1},
    "design_principles": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module_id", "title", "responsibility", "authority_paths", "dependencies", "status"],
        "properties": {
          "module_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "title": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "boundary": {"type": "string"},
          "authority_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "uniqueItems": true},
          "implementation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "legacy_implementation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "policy_module_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "status": {"enum": ["active", "deprecated"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
