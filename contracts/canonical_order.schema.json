{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangyu.local/schemas/canonical-order-v1.json",
  "title": "Shangyu Canonical Order",
  "type": "object",
  "required": [
    "schema_version",
    "order_id",
    "source",
    "platform_order_no",
    "buyer_member",
    "store_name",
    "warehouse_name",
    "recipient",
    "items",
    "issues"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "order_id": { "type": "string", "minLength": 1 },
    "platform_order_no": { "type": "string", "minLength": 1 },
    "buyer_member": { "type": "string", "minLength": 1 },
    "store_name": { "type": "string", "minLength": 1 },
    "warehouse_name": { "type": "string", "minLength": 1 },
    "order_status": { "type": "string" },
    "order_type": { "type": "string" },
    "payment_method": { "type": "string" },
    "payment_amount": { "type": "number", "minimum": 0 },
    "freight": { "type": "number", "minimum": 0 },
    "source": {
      "type": "object",
      "required": ["profile_id", "source_file", "source_order_id", "row_ref"],
      "properties": {
        "profile_id": { "type": "string" },
        "source_file": { "type": "string" },
        "source_order_id": { "type": "string" },
        "row_ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "recipient": {
      "type": "object",
      "required": ["name", "mobile", "province", "city", "district", "detail"],
      "properties": {
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "district": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["external_sku", "title", "quantity", "unit_price", "mapping_status"],
        "properties": {
          "external_sku": { "type": "string" },
          "product_code": { "type": ["string", "null"] },
          "spec_code": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unit_price": { "type": "number", "minimum": 0 },
          "is_gift": { "type": "boolean" },
          "mapping_status": { "enum": ["confirmed", "unconfirmed", "unmapped", "ambiguous"] }
        },
        "additionalProperties": true
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string" },
          "field": { "type": ["string", "null"] },
          "source_ref": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

