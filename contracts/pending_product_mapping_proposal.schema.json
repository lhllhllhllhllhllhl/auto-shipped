{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangyu.local/schemas/pending-product-mapping-proposal-v1.json",
  "title": "Pending Product Mapping Proposal",
  "type": "object",
  "required": [
    "proposal_id",
    "mapping_key",
    "company_id",
    "source_profile_id",
    "identifier_type",
    "source_value",
    "source_spec",
    "target_platform",
    "candidate_product_code",
    "candidate_spec_code",
    "evidence",
    "base_official_revision",
    "submitted_by",
    "submitted_at",
    "submission_operation_id",
    "proposal_status",
    "schema_version"
  ],
  "properties": {
    "proposal_id": {"type": "string", "pattern": "^proposal-[0-9a-f]{24}$"},
    "mapping_key": {"type": "string", "pattern": "^mapping-[0-9a-f]{24}$"},
    "company_id": {"type": "string", "minLength": 1},
    "source_profile_id": {"type": "string", "minLength": 1},
    "identifier_type": {"enum": ["product_code", "barcode", "product_name"]},
    "source_value": {"type": "string", "minLength": 1},
    "source_spec": {"type": "string"},
    "target_platform": {"type": "string", "minLength": 1},
    "candidate_product_code": {"type": "string", "minLength": 1},
    "candidate_spec_code": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "base_official_revision": {"type": "string", "minLength": 1},
    "submitted_by": {"type": "string", "minLength": 1},
    "submitted_at": {"type": "string", "format": "date-time"},
    "submission_operation_id": {"type": "string", "minLength": 1},
    "proposal_status": {"enum": ["pending", "conflict", "approved", "rejected", "already_exists"]},
    "schema_version": {"const": "1.0"}
  },
  "additionalProperties": false
}
